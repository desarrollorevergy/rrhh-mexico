# Copia este archivo como .env (ignorado por git) y rellena los valores.
# Nunca pongas valores reales aquí.

# Puerto de la API en local. En App Service lo entrega la plataforma.
PORT=3000

# Autenticación simulada: SOLO en local. Simula la cabecera de App Service con un usuario
# de prueba. La API se niega a arrancar con esto activo en producción o en Azure.
DEV_AUTH=true

# ID de objeto del grupo de Entra ID de cada rol. En local, con DEV_AUTH=true, se pueden
# dejar vacíos. En Azure se definen en la configuración del App Service.
ENTRA_GROUP_RRHH=
ENTRA_GROUP_DIRECCION=
ENTRA_GROUP_CONTROLLING=
ENTRA_GROUP_ALMACEN=
ENTRA_GROUP_IT=
ENTRA_GROUP_ETICA=
