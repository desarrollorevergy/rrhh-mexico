# Copia este archivo como .env (ignorado por git) y rellena los valores.
# Nunca pongas valores reales aquí.

# Puerto de la API en local. En App Service lo entrega la plataforma.
PORT=3000

# Autenticación simulada: SOLO en local. Simula la cabecera de App Service con un usuario
# de prueba. La API se niega a arrancar con esto activo en producción o en Azure.
DEV_AUTH=true

# ID de objeto del grupo de Entra ID de cada rol. En local, con DEV_AUTH=true, se pueden
# dejar vacíos. En Azure se definen en la configuración del App Service.
ENTRA_GROUP_RRHH=
ENTRA_GROUP_DIRECCION=
ENTRA_GROUP_CONTROLLING=
ENTRA_GROUP_ALMACEN=
ENTRA_GROUP_IT=
ENTRA_GROUP_ETICA=

# Base de datos. En local: SQL Server instalado en Windows, con un usuario de SQL solo
# para la aplicación. Si DB_SERVER está vacío, la API arranca sin base de datos.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=rrhh
DB_USER=rrhh_app
DB_PASSWORD=
DB_ENCRYPT=true
# Solo en local: el certificado de SQL Server es autofirmado. En Azure: false.
DB_TRUST_SERVER_CERTIFICATE=true
# Aplicar las migraciones pendientes al arrancar. En Azure: true. En local se usa "npm run db:migrate".
DB_MIGRATE_ON_START=false
